; 복사해서 backend/.env로 쓰거나, setup-db.bat을 실행하면 자동으로 만들어져요.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cocoding
DB_USER=root
DB_PASS=""
; 아무 긴 랜덤 문자열 - setup-db.bat이 자동 생성
JWT_SECRET=
; 프론트엔드 주소 — 여기 없는 주소에서 부르면 브라우저가 요청을 막아요.
; 개발 서버가 5173을 못 잡으면 5174, 5175로 밀려나서 셋 다 적어둡니다.
; 포트 자리에 *를 쓰면 그 주소의 아무 포트나 허용해요 (예: http://localhost:*).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

; ── 코코 AI 대화 ─────────────────────────────────
; 쓸 AI를 고르는 곳. 둘 다 켜져 있으면 OpenRouter를 먼저 쓰고,
; 둘 다 못 쓰면 대화 기능만 꺼지고 나머지는 그대로 동작해요.

; OpenRouter (실제 서비스용) — https://openrouter.ai 에서 키 발급
OPENROUTER_USE=true
OPENROUTER_KEY=
; 쓸 모델. 비워두면 google/gemini-omni-1.2-flash
; 더 싼 것: anthropic/claude-haiku-5.5 (백만 토큰당 입력 $0.1 / 출력 $0.5)
OPENROUTER_MODEL=google/gemini-omni-1.2-flash

; Gemini (AI Studio) — 개발·시험용. false로 두면 쓰지 않아요
GEMINI_API_TRUE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

; 학생 1명이 24시간 동안 코코에게 물어볼 수 있는 횟수
COCO_DAILY_LIMIT=30
; 사이트 전체에서 24시간 동안 코코가 대답하는 최대 횟수 (API 요금·할당량 보호)
COCO_GLOBAL_DAILY_LIMIT=1000

; 서버 재채점에 쓰는 Node.js 실행 파일 경로 (비워두면 PATH의 node). 예: /usr/bin/node
NODE_BIN=

; 비밀번호 찾기 메일. MAIL_ENABLED=false면 메일을 보내지 않고
; backend/data/mail.log에 내용만 적어둬요 (개발용)
MAIL_ENABLED=false
MAIL_FROM="코코딩 <no-reply@example.com>"
; 메일에 들어갈 사이트 주소 (비밀번호 재설정 링크에 사용)
APP_URL=http://localhost:5173
