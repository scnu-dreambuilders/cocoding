; 복사해서 backend/.env로 쓰거나, setup-db.bat을 실행하면 자동으로 만들어져요.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cocoding
DB_USER=root
DB_PASS=""
; 아무 긴 랜덤 문자열 - setup-db.bat이 자동 생성
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173

; 코코 AI 대화 - Gemini API 키는 Google AI Studio에서 발급
; 비워두면 대화 기능만 꺼지고 나머지는 그대로 동작해요
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
; 학생 1명이 24시간 동안 코코에게 물어볼 수 있는 횟수
COCO_DAILY_LIMIT=30
; 사이트 전체에서 24시간 동안 코코가 대답하는 최대 횟수 (API 요금·할당량 보호)
COCO_GLOBAL_DAILY_LIMIT=1000

; 서버 재채점에 쓰는 Node.js 실행 파일 경로 (비워두면 PATH의 node). 예: /usr/bin/node
NODE_BIN=
