; 복사해서 backend/.env로 쓰거나, setup-db.bat을 실행하면 자동으로 만들어져요.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cocoding
DB_USER=root
DB_PASS=""
; 아무 긴 랜덤 문자열 - setup-db.bat이 자동 생성
JWT_SECRET=
; 프론트엔드 주소 — 여기 없는 주소에서 부르면 브라우저가 요청을 막아요.
; 개발 서버가 5173을 못 잡으면 5174, 5175로 밀려나서 셋 다 적어둡니다.
; 포트 자리에 *를 쓰면 그 주소의 아무 포트나 허용해요 (예: http://localhost:*).
; 관리자 웹을 따로 띄우면 그 주소도 여기에 적어야 해요 (예: http://localhost:5180)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

; ── 코코 AI 대화 ─────────────────────────────────
; 쓸 AI를 고르는 곳. 둘 다 켜져 있으면 OpenRouter를 먼저 쓰고,
; 둘 다 못 쓰면 대화 기능만 꺼지고 나머지는 그대로 동작해요.

; OpenRouter (실제 서비스용) — https://openrouter.ai 에서 키 발급
OPENROUTER_USE=true
OPENROUTER_KEY=
; 쓸 모델. 비워두면 google/gemini-omni-1.2-flash
; 더 싼 것: anthropic/claude-haiku-5.5 (백만 토큰당 입력 $0.1 / 출력 $0.5)
OPENROUTER_MODEL=google/gemini-omni-1.2-flash

; Gemini (AI Studio) — 개발·시험용. false로 두면 쓰지 않아요
GEMINI_API_TRUE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

; 학생 1명이 24시간 동안 코코에게 물어볼 수 있는 횟수
; 2026-11-20부터 이 값은 관리자 웹(기준값 관리)에서 고칩니다.
; 여기 적은 값은 기준값을 한 번도 저장하지 않은 설치에서만 쓰이고,
; 실제 기본값은 backend/config/Settings.php 의 DEFAULTS 에 있어요.
COCO_DAILY_LIMIT=30
; 사이트 전체에서 24시간 동안 코코가 대답하는 최대 횟수 (API 요금·할당량 보호)
COCO_GLOBAL_DAILY_LIMIT=1000

; 서버 재채점에 쓰는 Node.js 실행 파일 경로 (비워두면 PATH의 node). 예: /usr/bin/node
NODE_BIN=

; 비밀번호 찾기 메일. MAIL_ENABLED=false면 메일을 보내지 않아요.
;  · 실제 서버: 비밀번호 찾기가 503과 "관리자에게 임시 비밀번호를 요청" 안내를 돌려줘요 (링크를 만들지 않음).
;    메일 없이 비밀번호를 도우려면 관리자 웹의 '임시 비밀번호' 발급을 쓰세요.
;  · 내 PC: 전처럼 링크를 만들고 backend/data/mail.log에 내용을 적어둬요 (개발용)
MAIL_ENABLED=false
MAIL_FROM="코코딩 <no-reply@example.com>"
; 메일에 들어갈 사이트 주소 (비밀번호 재설정 링크에 사용)
APP_URL=http://localhost:5173

; ── 기준 시간대 ──────────────────────────────────
; 서비스가 "오늘"을 세는 기준이에요. 출석·일일 제한·가입자 통계가 모두 이걸 따릅니다.
; PHP와 DB에 같은 값을 넣어주므로, 서버가 UTC로 설정돼 있어도 결과가 달라지지 않아요.
; 비워두면 Asia/Seoul 이에요.
APP_TIMEZONE=Asia/Seoul

; ── 운영 기록 ────────────────────────────────────
; backend/data/logs/에 하루 한 파일씩 쌓여요 (접근·사건·오류)
; 이름·이메일·질문 내용은 남기지 않고, 사용자는 번호로만 기록해요
LOG_ENABLED=true
; 며칠 지난 기록을 지울지
LOG_RETENTION_DAYS=30
